# Copy to .env.local (never commit real values). See README.md "Local development" for how the
# local values were produced (dedicated role + schema inside an existing shared Postgres).

# --- Database (local Postgres for dev; Amazon RDS in production) ---------------
DATABASE_URL=postgresql://<role>:<password>@127.0.0.1:5432/<database>

# TLS mode. Any `sslmode=` in the URL is ignored; this setting decides.
#   require    (default) TLS + certificate verification. Set DATABASE_SSL_CA for a private CA.
#   no-verify  TLS without certificate verification (e.g. a hosted dev DB with a self-signed cert).
#   disable    no TLS (local Postgres — use this for the setup above).
DATABASE_SSL=disable
# DATABASE_SSL_CA=C:\path\to\ca.crt   # or the PEM contents
# DATABASE_POOL_MAX=5

# Optional: separate connection string used only by `npm run db:migrate` (DDL), if the
# day-to-day app role should not also own schema changes.
# MIGRATION_DATABASE_URL=

# --- Auth (NextAuth.js) ---------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Scripts only ----------------------------------------------------------------
# Password for users created by `npm run user:bootstrap` / `npm run db:seed`. Min 12 chars.
# Pass it on the command line for a one-off run rather than saving it in a file.
# NEW_USER_PASSWORD=
